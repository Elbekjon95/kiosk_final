# Google AI Studio kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Ixtiyoriy) Gemini API manzili — faqat proksi orqali ishlatilganda o'zgartiring
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenWeather kaliti — reyslar shaharlari ob-havosi uchun: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Admin panel paroli (/admin). Bo'sh qoldirilsa birinchi ishga tushishda tasodifiy parol yaratiladi.
ADMIN_PASSWORD=

# Server manzili. Faqat shu kompyuterdan kirish uchun 127.0.0.1,
# tarmoqdagi boshqa kompyuterlardan (masalan admin) kirish uchun 0.0.0.0
HOST=127.0.0.1
PORT=3100
